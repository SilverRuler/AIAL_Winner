# MongoDB Database (Atlas)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aial_winner

# Admin credentials for editing/deleting
ADMIN_ID=your_admin_id
ADMIN_PW=your_admin_password

# LLM evaluation service (sr-combo on oci2 - fallback)
LLM_API_URL=http://oci2.silverruler.xyz:20129/v1/chat/completions
LLM_MODEL=sr-combo
LLM_API_KEY=your-llm-api-key-here

# NVIDIA NIM Vision Model (1순위, 2순위, 3순위)
NVIDIA_API_KEY=your_nvidia_api_key_here
NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NIM_MODEL=mistralai/mistral-large-4-1t-a52b
NIM_MODEL_2=meta/muse-glimmer-30b
NIM_MODEL_3=nvidia/nemotron-3.5-super-vl-120b-a12b
